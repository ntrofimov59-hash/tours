{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "styled-system", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "paths": {
      "@/*": ["./src/*"],
      "@colors": ["./src/styles/colors.scss"],
      "@sizes": ["./src/styles/sizes.scss"]
    }
  }
}
