---
import styles from "./Header.module.scss";

interface Props {
  title?: string;
}

const { title = "My Site" } = Astro.props;
---

<header class={styles.header}>
  <div class={styles.container}>
    <a href="/" class={styles.logo}>{title}</a>
    <nav class={styles.nav}>
      <a href="/" class={styles.navLink}>Главная</a>
      <a href="/tours" class={styles.navLink}>Туры</a>
      <a href="/about" class={styles.navLink}>О нас</a>
      <a href="/contacts" class={styles.navLink}>Контакты</a>
    </nav>
  </div>
</header>
